<!DOCTYPE html>
<html>
<body>

<form onsubmit="return validate()">
    Email:
    <input type="text" id="email">
    <input type="submit" value="Submit">
</form>

<script>
function validate()
{
    let email = document.getElementById("email").value;

    if (email.includes("@"))
    {
        alert("Valid Email");
        return true;
    }
    else
    {
        alert("Email must contain @");
        return false;
    }
}
</script>

</body>
</html>
