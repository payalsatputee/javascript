<!DOCTYPE html>
<html>
<body>

<script>
let car = {
    brand: "Toyota",
    model: "Innova",
    year: 2024,

    display: function()
    {
        document.write("Brand: " + this.brand + "<br>");
        document.write("Model: " + this.model + "<br>");
        document.write("Year: " + this.year);
    }
};

car.display();
</script>

</body>
</html>
